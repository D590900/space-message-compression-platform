+import zipfile
+from pathlib import Path
+
+
+MAX_ARCHIVE_BYTES = 128 * 1024 * 1024
+MAX_ARCHIVE_FILES = 4096
+
+
+def _make_deterministic_archive(output_path, root):
+    with zipfile.ZipFile(output_path + '.zip', 'w', compression=zipfile.ZIP_STORED) as archive:
+        for path in sorted(Path(root).rglob('*')):
+            if not path.is_file():
+                continue
+            relative = path.relative_to(root).as_posix()
+            info = zipfile.ZipInfo(relative, date_time=(1980, 1, 1, 0, 0, 0))
+            info.compress_type = zipfile.ZIP_STORED
+            info.external_attr = 0o100400 << 16
+            archive.writestr(info, path.read_bytes())
+
+
+def _safe_extract_archive(archive_path, output_dir):
+    destination = Path(output_dir).resolve()
+    with zipfile.ZipFile(archive_path, 'r') as archive:
+        entries = archive.infolist()
+        if len(entries) > MAX_ARCHIVE_FILES:
+            raise ValueError('HiNeRV archive contains too many files')
+        if sum(entry.file_size for entry in entries) > MAX_ARCHIVE_BYTES:
+            raise ValueError('HiNeRV archive expands beyond the bounded contract')
+        for entry in entries:
+            target = (destination / entry.filename).resolve()
+            if destination not in target.parents or entry.is_dir():
+                raise ValueError('HiNeRV archive contains an unsafe path')
+            target.parent.mkdir(parents=True, exist_ok=True)
+            with archive.open(entry, 'r') as source, target.open('wb') as sink:
+                data = source.read(MAX_ARCHIVE_BYTES + 1)
+                if len(data) > MAX_ARCHIVE_BYTES:
+                    raise ValueError('HiNeRV archive member exceeds the bounded contract')
+                sink.write(data)
+
+
+def _bounded_zlib_decompress(data):
+    decoder = zlib.decompressobj()
+    output = decoder.decompress(data, MAX_ARCHIVE_BYTES + 1)
+    if len(output) > MAX_ARCHIVE_BYTES or decoder.unconsumed_tail or not decoder.eof:
+        raise ValueError('HiNeRV state expands beyond the bounded contract')
+    return output
 
 
