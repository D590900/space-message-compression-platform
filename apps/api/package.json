{
  "name": "@smcp/api",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": "https://github.com/D590900/space-message-compression-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "format:check": "prettier --check src test package.json tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1124.0",
    "@aws-sdk/s3-request-presigner": "3.1124.0",
    "@clerk/backend": "3.17.0",
    "@fastify/rate-limit": "11.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@smcp/schemas": "workspace:*",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "undici": "8.10.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
