# Clerk (required for dashboard and real API-key E2E)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Public endpoints
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# PostgreSQL / Valkey
DATABASE_URL=postgresql://smcp:smcp@postgres:5432/smcp
VALKEY_URL=redis://valkey:6379/0

# S3-compatible object storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=smcp-private
S3_ACCESS_KEY_ID=smcp-local
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
KEY_ROTATION_POLL_MS=5000

# Internal service authentication (generate locally; never commit a value)
INTERNAL_WORKER_TOKEN=
WEBHOOK_SECRET_ENCRYPTION_KEY=
WEBHOOK_POLL_MS=1000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000

# Observability (generate a metrics token; OTLP endpoint must include /v1/traces)
METRICS_BEARER_TOKEN=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Safety limits
MAX_UPLOAD_BYTES=1073741824
WORKER_CLAIM_IDLE_MS=1800000
WORKER_CLAIM_BATCH=10
WORKER_MAX_ATTEMPTS=3
MAX_IMAGE_PIXELS=100000000
MAX_AUDIO_SECONDS=3600
MAX_VIDEO_SECONDS=1800
DELETE_ORIGINALS_AFTER_SECONDS=0
CAPSULE_DEFAULT_BUDGET_BYTES=2000000
